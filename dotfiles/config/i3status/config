general {
        colors = true
        interval = 5
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "battery all"
order += "tztime local"

cpu_usage {
        format = "CPU %usage"
}

memory {
        format = "RAM %used/%total"
        threshold_degraded = "1G"
        threshold_critical = "500M"
}

disk "/" {
        format = "DISK %avail"
}

#battery all {
#        format = "%status %percentage %remaining"
#}

tztime local {
        format = "%Y-%m-%d %H:%M"
}
